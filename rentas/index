<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Echo Rentas — Prototipo visual</title>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@400;500;600;700;800&family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{
  --blue:#1847CC;--blue-mid:#2558E8;--blue-light:#EBF0FD;
  --green:#059669;--green-light:#ECFDF5;
  --ink:#0C1320;--body:#374151;--muted:#6B7280;
  --border:#E5E7EB;--bg:#F9FAFB;--white:#fff;
  --coral:#DC2626;--coral-light:#FEF2F2;--yellow:#D97706;--yellow-light:#FFFBEB;
  --shadow:0 1px 3px rgba(0,0,0,.08),0 4px 16px rgba(0,0,0,.06);
  --shadow-lg:0 4px 6px rgba(0,0,0,.05),0 14px 44px rgba(0,0,0,.12);
}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:'DM Sans',sans-serif;background:var(--white);color:var(--body);line-height:1.6;-webkit-font-smoothing:antialiased}
a{text-decoration:none;color:inherit}
h1,h2,h3,h4{font-family:'Bricolage Grotesque',sans-serif;color:var(--ink);letter-spacing:-.02em;line-height:1.12}
.wrap{max-width:1140px;margin:0 auto;padding:0 22px}
.hidden{display:none!important}
.badge{display:inline-flex;align-items:center;gap:6px;font-size:11.5px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;padding:5px 12px;border-radius:100px}
.badge-blue{color:var(--blue);background:var(--blue-light)}
.badge-green{color:var(--green);background:var(--green-light)}
.badge-coral{color:var(--coral);background:var(--coral-light)}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:13px 26px;border-radius:10px;font-size:14.5px;font-weight:600;font-family:'DM Sans',sans-serif;border:none;cursor:pointer;transition:all .18s;white-space:nowrap}
.btn-primary{background:var(--blue);color:#fff}
.btn-primary:hover{background:var(--blue-mid);transform:translateY(-1px);box-shadow:0 6px 18px rgba(24,71,204,.32)}
.btn-light{background:#fff;color:var(--ink);border:1px solid var(--border)}
.btn-light:hover{border-color:var(--blue);color:var(--blue)}
.btn-ghost{background:rgba(255,255,255,.16);color:#fff;backdrop-filter:blur(6px)}
.btn-ghost:hover{background:rgba(255,255,255,.28)}
.btn-block{width:100%}

/* NAV */
.nav{position:sticky;top:0;z-index:40;background:rgba(255,255,255,.9);backdrop-filter:blur(12px);border-bottom:1px solid var(--border)}
.nav-in{display:flex;align-items:center;justify-content:space-between;height:64px}
.logo{display:flex;align-items:center;gap:9px;font-family:'Bricolage Grotesque';font-weight:800;font-size:18px;color:var(--ink)}
.logo span{color:var(--blue)}
.logo-m{width:30px;height:30px;background:var(--blue);border-radius:8px;display:flex;align-items:center;justify-content:center}
.nav-links{display:flex;align-items:center;gap:6px}
.nav-links a{padding:9px 14px;border-radius:8px;font-size:14px;font-weight:500;color:var(--body);cursor:pointer}
.nav-links a:hover{background:var(--bg);color:var(--ink)}
.nav-links a.on{color:var(--blue);font-weight:600}
.nav-cta{margin-left:6px}
.burger{display:none;background:none;border:none;cursor:pointer;color:var(--ink);padding:4px}
.burger svg{width:26px;height:26px;display:block}

.screen{display:none}
.screen.on{display:block;animation:fade .3s ease}
@keyframes fade{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}

/* HERO + BANNERS */
.hero{padding:46px 0 10px;text-align:center}
.hero h1{font-size:clamp(30px,5vw,50px);font-weight:800}
.hero .lead{font-size:17px;color:var(--muted);max-width:560px;margin:14px auto 0}
.banners{display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:34px}
.banner{position:relative;border-radius:22px;padding:38px 34px;overflow:hidden;color:#fff;min-height:260px;display:flex;flex-direction:column;justify-content:flex-end;box-shadow:var(--shadow-lg)}
.banner.guest{background:linear-gradient(150deg,#2558E8 0%,#1847CC 55%,#0C1320 130%)}
.banner.owner{background:linear-gradient(150deg,#0C1320 0%,#1A2740 60%,#1847CC 150%)}
.banner .emoji{font-size:34px;margin-bottom:auto}
.banner h2{color:#fff;font-size:26px;font-weight:700;margin-bottom:8px}
.banner p{color:rgba(255,255,255,.82);font-size:15px;max-width:340px;margin-bottom:20px}
.banner .glow{position:absolute;width:280px;height:280px;border-radius:50%;background:rgba(123,168,255,.25);filter:blur(60px);top:-80px;right:-60px}

/* NOTICIAS */
.section{padding:42px 0}
.sec-head{display:flex;align-items:end;justify-content:space-between;gap:16px;margin-bottom:20px}
.sec-head h2{font-size:clamp(22px,3vw,30px);font-weight:700}
.sec-head p{color:var(--muted);font-size:14px}
.see-all{color:var(--blue);font-weight:600;font-size:14px;cursor:pointer;white-space:nowrap}
.news-row{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
.news{border:1px solid var(--border);border-radius:16px;padding:20px;background:#fff;transition:transform .15s,box-shadow .15s}
.news:hover{transform:translateY(-3px);box-shadow:var(--shadow)}
.news .k{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;margin-bottom:10px}
.news h4{font-size:16px;margin-bottom:6px}
.news p{font-size:13.5px;color:var(--muted)}
.news .date{font-size:12px;color:var(--muted);margin-top:12px}

/* PROPERTY CARDS */
.grid-props{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}
.pcard{border-radius:16px;overflow:hidden;cursor:pointer;background:#fff;transition:transform .15s}
.pcard:hover{transform:translateY(-4px)}
.pphoto{height:200px;position:relative;display:flex;align-items:flex-start;justify-content:space-between;padding:12px}
.pphoto .fav,.pphoto .shr{width:34px;height:34px;border-radius:50%;background:rgba(255,255,255,.92);display:flex;align-items:center;justify-content:center;font-size:15px;border:none;cursor:pointer}
.pphoto .tagrow{position:absolute;left:12px;bottom:12px;display:flex;gap:6px;flex-wrap:wrap}
.ptag{background:rgba(12,19,32,.62);color:#fff;font-size:11px;font-weight:600;padding:3px 9px;border-radius:100px;backdrop-filter:blur(4px)}
.pbody{padding:14px 4px 4px}
.prow{display:flex;justify-content:space-between;align-items:start;gap:8px}
.pcard h4{font-size:16px}
.pcard .loc{font-size:13px;color:var(--muted);margin-top:1px}
.pcard .rate{font-size:13px;font-weight:600;color:var(--ink);white-space:nowrap}
.pmeta{font-size:13px;color:var(--muted);margin-top:8px}
.pprice{margin-top:8px;font-size:15px;color:var(--ink)}
.pprice b{font-family:'Bricolage Grotesque';font-weight:700;font-size:17px}

/* FILTERS */
.filters{position:sticky;top:64px;z-index:30;background:#fff;border-bottom:1px solid var(--border);padding:14px 0}
.filt-row{display:flex;gap:10px;flex-wrap:wrap;align-items:center}
.filt{display:inline-flex;align-items:center;gap:7px;border:1px solid var(--border);border-radius:100px;padding:9px 15px;font-size:13.5px;color:var(--body);background:#fff;cursor:pointer;font-family:inherit}
.filt:hover{border-color:var(--blue)}
.filt.on{background:var(--blue-light);border-color:var(--blue);color:var(--blue);font-weight:600}
.filt select,.filt input{border:none;background:none;font-family:inherit;font-size:13.5px;color:var(--body);outline:none}

/* DETAIL */
.det-back{display:inline-flex;align-items:center;gap:6px;color:var(--muted);font-size:14px;cursor:pointer;margin-bottom:16px}
.det-back:hover{color:var(--ink)}
.gallery{display:grid;grid-template-columns:2fr 1fr 1fr;grid-template-rows:130px 130px;gap:8px;border-radius:18px;overflow:hidden;margin-bottom:24px}
.gallery>div:first-child{grid-row:span 2}
.det-grid{display:grid;grid-template-columns:1fr 360px;gap:34px;align-items:start}
.amen{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:14px}
.amen div{display:flex;align-items:center;gap:9px;font-size:14px;color:var(--body)}
.map-ph{height:200px;border-radius:14px;background:linear-gradient(135deg,#EBF0FD,#dfeaff);display:flex;align-items:center;justify-content:center;color:var(--blue);font-weight:600;margin-top:14px;border:1px solid var(--border)}
.book{border:1px solid var(--border);border-radius:18px;padding:24px;box-shadow:var(--shadow);position:sticky;top:90px}
.book .pr{font-family:'Bricolage Grotesque';font-weight:800;font-size:26px;color:var(--ink)}
.book .ln{display:flex;justify-content:space-between;font-size:14px;padding:10px 0;border-bottom:1px solid var(--border)}

/* SERVICES */
.serv-hero{background:var(--bg);border-radius:24px;padding:46px 34px;text-align:center;margin-bottom:36px}
.serv-hero h1{font-size:clamp(26px,4vw,40px);font-weight:800;max-width:680px;margin:14px auto 0}
.serv-hero .lead{color:var(--muted);font-size:16px;max-width:560px;margin:12px auto 22px}
.serv-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
.scard{border:1px solid var(--border);border-radius:16px;padding:22px;background:#fff;transition:transform .15s,box-shadow .15s}
.scard:hover{transform:translateY(-3px);box-shadow:var(--shadow)}
.sico{width:48px;height:48px;border-radius:13px;background:var(--blue-light);display:flex;align-items:center;justify-content:center;font-size:23px;margin-bottom:14px}
.scard h4{font-size:15.5px;margin-bottom:5px}
.scard p{font-size:13.5px;color:var(--muted)}

/* FORM */
.form-card{max-width:680px;margin:0 auto;border:1px solid var(--border);border-radius:20px;padding:34px;box-shadow:var(--shadow)}
.fgrid{display:grid;grid-template-columns:1fr 1fr;gap:16px}
.field{margin-bottom:4px}
.field.full{grid-column:1 / -1}
.field label{display:block;font-size:12.5px;font-weight:600;color:var(--ink);margin-bottom:6px}
.field input,.field select,.field textarea{width:100%;border:1.5px solid var(--border);border-radius:9px;padding:11px 13px;font-size:14px;font-family:inherit;color:var(--ink);outline:none;background:#fff;transition:border-color .18s}
.field input:focus,.field select:focus,.field textarea:focus{border-color:var(--blue);box-shadow:0 0 0 3px rgba(24,71,204,.08)}
.drop{border:1.5px dashed var(--border);border-radius:11px;padding:22px;text-align:center;color:var(--muted);font-size:13.5px;cursor:pointer}
.drop:hover{border-color:var(--blue);color:var(--blue)}
.ok-msg{display:none;background:var(--green-light);border:1px solid #A7F3D0;color:var(--green);border-radius:12px;padding:16px;text-align:center;font-size:14px;margin-top:18px}

/* STEPS */
.steps{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;margin-top:30px}
.step .n{font-family:'Bricolage Grotesque';font-weight:800;font-size:15px;color:var(--blue);width:34px;height:34px;border-radius:50%;background:var(--blue-light);display:flex;align-items:center;justify-content:center;margin-bottom:12px}
.step h4{font-size:15px;margin-bottom:4px}
.step p{font-size:13px;color:var(--muted)}

/* DASHBOARD */
.dash-note{background:var(--yellow-light);border:1px solid rgba(217,119,6,.25);color:var(--yellow);border-radius:12px;padding:13px 16px;font-size:13.5px;margin-bottom:22px;font-weight:600}
.kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
.kpi{border:1px solid var(--border);border-radius:14px;padding:18px;background:#fff}
.kpi .l{font-size:11px;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);font-weight:600}
.kpi .v{font-family:'Bricolage Grotesque';font-weight:800;font-size:24px;color:var(--ink);margin-top:6px}
.kpi .v.green{color:var(--green)}
.dash-2{display:grid;grid-template-columns:1.3fr 1fr;gap:20px;margin-top:20px}
.panel{border:1px solid var(--border);border-radius:16px;padding:20px;background:#fff}
.panel h4{font-size:16px;margin-bottom:14px}
.resv{display:flex;align-items:center;justify-content:space-between;padding:11px 0;border-bottom:1px solid var(--border);font-size:14px}
.resv:last-child{border-bottom:none}
.dot{width:8px;height:8px;border-radius:50%;display:inline-block;margin-right:8px}
.cal{display:grid;grid-template-columns:repeat(7,1fr);gap:5px}
.cal .d{aspect-ratio:1;border-radius:7px;display:flex;align-items:center;justify-content:center;font-size:12px;background:var(--bg);color:var(--body)}
.cal .d.b{background:var(--blue);color:#fff;font-weight:600}
.cal .d.h{background:var(--coral-light);color:var(--coral);font-weight:600}

/* FOOTER */
.foot{background:var(--ink);color:rgba(255,255,255,.6);padding:40px 0;margin-top:50px}
.foot a{color:rgba(255,255,255,.6)}
.foot a:hover{color:#fff}
.foot-in{display:flex;justify-content:space-between;flex-wrap:wrap;gap:20px;font-size:13.5px}

@media (max-width:880px){
  .nav-links{position:fixed;top:64px;left:0;right:0;background:#fff;flex-direction:column;align-items:stretch;padding:12px;gap:2px;border-bottom:1px solid var(--border);box-shadow:var(--shadow);transform:translateY(-130%);transition:transform .25s;z-index:39}
  .nav-links.open{transform:none}
  .nav-links a{padding:13px 14px}
  .nav-cta{margin:6px 0 0}
  .burger{display:block}
  .banners{grid-template-columns:1fr}
  .news-row,.grid-props,.serv-grid{grid-template-columns:1fr}
  .det-grid{grid-template-columns:1fr}
  .book{position:static}
  .gallery{grid-template-columns:1fr 1fr;grid-template-rows:120px 120px}
  .gallery>div:first-child{grid-row:span 1;grid-column:span 2}
  .fgrid{grid-template-columns:1fr}
  .steps,.kpis{grid-template-columns:1fr 1fr}
  .dash-2{grid-template-columns:1fr}
  .filters{top:64px}
}
@media (max-width:480px){
  .kpis{grid-template-columns:1fr}
  .banner{padding:30px 24px;min-height:230px}
}
</style>
</head>
<body>

<!-- NAV -->
<div class="nav">
  <div class="wrap nav-in">
    <div class="logo" onclick="ir('inicio')" style="cursor:pointer">
      <div class="logo-m"><svg viewBox="0 0 20 20" width="17" height="17"><path d="M2 10C2 5.58 5.58 2 10 2C14.42 2 18 5.58 18 10C18 14.42 14.42 18 10 18" stroke="white" stroke-width="2.2" stroke-linecap="round" fill="none"/><path d="M10 7V13M7 10H13" stroke="white" stroke-width="2.2" stroke-linecap="round"/></svg></div>
      Echo <span>Rentas</span>
    </div>
    <button class="burger" onclick="document.getElementById('navlinks').classList.toggle('open')">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
    </button>
    <div class="nav-links" id="navlinks">
      <a id="lk-inicio" class="on" onclick="ir('inicio')">Inicio</a>
      <a id="lk-propietarios" onclick="ir('propietarios')">Administra tu propiedad</a>
      <a id="lk-dashboard" onclick="ir('dashboard')">Dashboard</a>
      <a class="btn btn-primary nav-cta" onclick="ir('propietarios')">Promociona tu depto</a>
    </div>
  </div>
</div>

<!-- ============ INICIO ============ -->
<div class="screen on" id="inicio">
  <div class="wrap">
    <div class="hero">
      <span class="badge badge-green">Administración profesional · Tulum &amp; Riviera Maya</span>
      <h1 style="margin-top:14px">Haz que tu departamento genere ingresos</h1>
      <p class="lead">Administramos tu propiedad de principio a fin para maximizar su ocupación y rentabilidad. Tú solo recibes los resultados.</p>
    </div>

    <div style="margin-top:34px">
      <div class="banner owner">
        <div class="glow"></div>
        <div class="emoji">💼</div>
        <h2>¿Quieres que tu departamento genere ingresos?</h2>
        <p style="max-width:460px">Nos encargamos de publicar, atender huéspedes, limpiar, mantener y reportar. Sin que muevas un dedo.</p>
        <div><button class="btn btn-primary" onclick="ir('propietarios')">Quiero promocionar mi departamento →</button></div>
      </div>
    </div>
  </div>

  <!-- Servicios (teaser) -->
  <div class="wrap section" style="padding-top:0">
    <div class="sec-head">
      <div><h2>Tú no mueves un dedo</h2><p>Un solo equipo se encarga de todo.</p></div>
      <span class="see-all" onclick="ir('propietarios')">Ver todos los servicios →</span>
    </div>
    <div class="serv-grid" id="home-serv"></div>
    <div style="text-align:center;margin-top:30px">
      <button class="btn btn-primary" onclick="ir('propietarios')">Quiero promocionar mi departamento</button>
    </div>
  </div>
</div>

<!-- ============ PROPIETARIOS ============ -->
<div class="screen" id="propietarios">
  <div class="wrap section">
    <div class="serv-hero">
      <span class="badge badge-green">Administración profesional</span>
      <h1>Tu departamento, administrado de principio a fin</h1>
      <p class="lead">Tú recibes ingresos; nosotros nos encargamos de todo: publicación, huéspedes, limpieza, mantenimiento y reportes.</p>
      <button class="btn btn-primary" onclick="document.getElementById('owner-form').scrollIntoView({behavior:'smooth'})">Quiero promocionar mi departamento</button>
    </div>

    <div class="sec-head"><div><h2>Todo incluido en el servicio</h2><p>Un solo equipo para maximizar tu ocupación y rentabilidad.</p></div></div>
    <div class="serv-grid" id="serv-grid"></div>

    <div class="sec-head" style="margin-top:46px"><div><h2>Cómo funciona</h2></div></div>
    <div class="steps">
      <div class="step"><div class="n">1</div><h4>Cuéntanos de tu depto</h4><p>Llenas el formulario en 2 minutos.</p></div>
      <div class="step"><div class="n">2</div><h4>Lo preparamos</h4><p>Fotografía profesional y anuncio optimizado.</p></div>
      <div class="step"><div class="n">3</div><h4>Lo publicamos</h4><p>Airbnb, Booking y más canales.</p></div>
      <div class="step"><div class="n">4</div><h4>Tú cobras</h4><p>Gestionamos todo y te enviamos reportes.</p></div>
    </div>

    <!-- Formulario -->
    <div id="owner-form" style="margin-top:50px">
      <div class="sec-head"><div><h2>Solicita administración</h2><p>Te contactamos en menos de 24 horas.</p></div></div>
      <div class="form-card">
        <div class="fgrid">
          <div class="field"><label>Nombre completo</label><input id="f-nombre" placeholder="Tu nombre"></div>
          <div class="field"><label>Teléfono</label><input id="f-tel" placeholder="+52 ..."></div>
          <div class="field"><label>Correo electrónico</label><input id="f-correo" placeholder="tu@correo.com"></div>
          <div class="field"><label>Desarrollo o condominio</label><input id="f-desarrollo" placeholder="Ej. Manzana 80"></div>
          <div class="field full"><label>Dirección del departamento</label><input id="f-direccion" placeholder="Calle, número, depto"></div>
          <div class="field"><label>Habitaciones</label><input id="f-hab" type="number" placeholder="2"></div>
          <div class="field"><label>Baños</label><input id="f-banos" type="number" placeholder="2"></div>
          <div class="field"><label>Capacidad máxima</label><input id="f-cap" type="number" placeholder="4"></div>
          <div class="field"><label>¿Actualmente se renta?</label><select id="f-renta"><option>No</option><option>Sí</option></select></div>
          <div class="field full"><label>Plataformas donde está publicado</label><input id="f-plat" placeholder="Airbnb, Booking… (opcional)"></div>
          <div class="field full"><label>Calendario de disponibilidad</label><input id="f-disp" placeholder="Ej. Disponible todo el año / temporadas"></div>
          <div class="field full"><label>Fotografías del inmueble</label><div class="drop">📷 Arrastra o toca para subir fotos (opcional)</div></div>
          <div class="field full"><label>Comentarios adicionales</label><textarea id="f-coment" rows="3" placeholder="Cuéntanos lo que quieras"></textarea></div>
        </div>
        <button class="btn btn-primary btn-block" id="btn-solicitud" style="margin-top:20px" onclick="enviarSolicitud()">Enviar solicitud</button>
        <div class="ok-msg" id="owner-ok">✓ ¡Solicitud recibida! Un asesor de Echo te contactará muy pronto.</div>
      </div>
    </div>
  </div>
</div>

<!-- ============ DASHBOARD (Fase 2) ============ -->
<div class="screen" id="dashboard">
  <div class="wrap section">
    <div class="dash-note">🔒 Vista previa — Fase 2. Así verá su propiedad cada propietario en su panel privado.</div>
    <div class="sec-head"><div><h2>Panel del propietario</h2><p>Depto 204 · Aldea Zamá · Octubre 2026</p></div></div>
    <div class="kpis">
      <div class="kpi"><div class="l">Ocupación del mes</div><div class="v">82%</div></div>
      <div class="kpi"><div class="l">Ingresos del mes</div><div class="v green">$38,400</div></div>
      <div class="kpi"><div class="l">Comisión Echo</div><div class="v">$7,680</div></div>
      <div class="kpi"><div class="l">Pago neto a ti</div><div class="v green">$30,720</div></div>
    </div>
    <div class="dash-2">
      <div class="panel">
