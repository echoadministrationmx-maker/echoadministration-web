<script>
/* ===== Conexión Supabase ===== */
const URL = 'https://nwqigjkmlkwyyblgqppm.supabase.co/rest/v1';
const KEY = 'sb_publishable_Gscgjva4RQkFZfwANPpueg_rKfWJ_nU';
const H = { 'apikey': KEY, 'Authorization': 'Bearer ' + KEY, 'Accept': 'application/json', 'Content-Type': 'application/json' };

/* ===== DATOS (fáciles de editar) ===== */
const SERVICIOS = [
  { i:'🅰️', t:'Publicación en Airbnb', d:'Tu anuncio en el canal #1 de renta vacacional.' },
  { i:'🅱️', t:'Publicación en Booking.com', d:'Alcance a huéspedes de todo el mundo.' },
  { i:'🌐', t:'Otros canales de renta', d:'VRBO, Expedia y plataformas locales.' },
  { i:'📸', t:'Fotografía profesional', d:'Imágenes que hacen que tu depto destaque.' },
  { i:'✍️', t:'Anuncio optimizado', d:'Creación y optimización del listado.' },
  { i:'📈', t:'Precios dinámicos', d:'Tarifas que se ajustan a la demanda.' },
  { i:'📅', t:'Gestión de reservas', d:'Calendario y bookings administrados por nosotros.' },
  { i:'💬', t:'Atención al huésped 24/7', d:'Respondemos por ti a cualquier hora.' },
  { i:'🔑', t:'Check‑in y check‑out', d:'Recibimos y despedimos a cada huésped.' },
  { i:'🧹', t:'Coordinación de limpieza', d:'Limpieza profesional entre estancias.' },
  { i:'🔧', t:'Coordinación de mantenimiento', d:'Resolvemos incidencias rápido.' },
  { i:'📊', t:'Reportes financieros', d:'Ingresos, comisiones y ocupación claros.' },
  { i:'🛡️', t:'Administración integral', d:'Un solo equipo para todo, sin que muevas un dedo.' },
];

function renderHome(){
  document.getElementById('home-serv').innerHTML = SERVICIOS.slice(0,6).map(servCard).join('');
}
function servCard(s){
  return '<div class="scard"><div class="sico">'+s.i+'</div><h4>'+s.t+'</h4><p>'+s.d+'</p></div>';
}
function renderServicios(){
  document.getElementById('serv-grid').innerHTML = SERVICIOS.map(servCard).join('');
}
function renderCal(){
  let h=''; const res={5:'b',6:'b',7:'b',14:'h',18:'b',19:'b',20:'b',21:'b'};
  for(let d=1;d<=28;d++){ h += '<div class="d '+(res[d]||'')+'">'+d+'</div>'; }
  document.getElementById('cal').innerHTML = h;
}
async function enviarSolicitud(){
  const g = id => (document.getElementById(id) ? document.getElementById(id).value : '').trim();
  const nombre = g('f-nombre');
  const ok = document.getElementById('owner-ok');
  const btn = document.getElementById('btn-solicitud');
  if (!nombre){ alert('Por favor escribe tu nombre para continuar.'); return; }
  if (btn){ btn.disabled = true; btn.textContent = 'Enviando…'; }
  try {
    const r = await fetch(URL + '/rpc/crear_solicitud_propietario', {
      method:'POST', headers:H,
      body: JSON.stringify({
        p_nombre:nombre, p_telefono:g('f-tel'), p_correo:g('f-correo'),
        p_desarrollo:g('f-desarrollo'), p_direccion:g('f-direccion'),
        p_habitaciones:g('f-hab'), p_banos:g('f-banos'), p_capacidad:g('f-cap'),
        p_se_renta:g('f-renta'), p_plataformas:g('f-plat'),
        p_disponibilidad:g('f-disp'), p_comentarios:g('f-coment')
      })
    });
    const d = await r.json();
    if (!r.ok || !d || !d.ok) throw new Error('fail');
    ok.style.display = 'block';
    window.scrollTo({top: ok.offsetTop - 200, behavior:'smooth'});
    ['f-nombre','f-tel','f-correo','f-desarrollo','f-direccion','f-hab','f-banos','f-cap','f-plat','f-disp','f-coment']
      .forEach(i => { const e = document.getElementById(i); if (e) e.value = ''; });
    if (btn){ btn.disabled = false; btn.textContent = 'Enviar solicitud'; }
  } catch(e){
    alert('No se pudo enviar la solicitud. Revisa tu conexión e intenta de nuevo.');
    if (btn){ btn.disabled = false; btn.textContent = 'Enviar solicitud'; }
  }
}
function ir(id){
  document.querySelectorAll('.screen').forEach(s=>s.classList.remove('on'));
  document.getElementById(id).classList.add('on');
  document.querySelectorAll('.nav-links a[id^=lk-]').forEach(a=>a.classList.remove('on'));
  const lk = document.getElementById('lk-'+id); if(lk) lk.classList.add('on');
  document.getElementById('navlinks').classList.remove('open');
  window.scrollTo({top:0,behavior:'instant'});
}

renderHome(); renderServicios(); renderCal();
</script>
